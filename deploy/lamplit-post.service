# Inert template: select a fresh standalone installation and explicit private config.
[Unit]
Description=Lamplit Post standalone backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/opt/lamplit-post
ExecStart=/opt/node24/bin/node /opt/lamplit-post/dist/cli.cjs serve --config /etc/lamplit-post/post.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
