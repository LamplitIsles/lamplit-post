# Template only. Supply the reviewed Node24/pnpm12 tools and initialize app once.
[Unit]
Description=Lamplit Post native managed application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/home/REPLACE_WITH_SERVICE_USER/.local/share/lamplit-post/app
Environment=PATH=/opt/node24/bin:/opt/pnpm12/bin:/usr/bin:/bin
ExecStart=/opt/pnpm12/bin/pnpm run start
Restart=on-failure
RestartSec=5s
TimeoutStartSec=150s
TimeoutStopSec=40s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
