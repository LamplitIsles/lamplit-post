{
  "name": "lamplit-post",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run package && node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "format": "prettier --write src tests scripts",
    "postinstall": "patch-package --error-on-fail",
    "frontend:check": "npm run check --prefix web",
    "frontend:dev": "npm run dev --prefix web"
  },
  "dependencies": {
    "@cordisjs/plugin-http": "0.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@satorijs/adapter-qq": "4.14.0",
    "@satorijs/core": "4.6.0",
    "cosmokit": "1.8.1",
    "file-type": "^22.2.0",
    "matrix-js-sdk": "44.0.0",
    "patch-package": "8.0.1",
    "qrcode": "^1.5.4",
    "smol-toml": "1.6.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist/cli.cjs",
    "dist/web",
    "docs",
    "deploy",
    "examples/post.toml",
    "LICENSE",
    "patches",
    "package-lock.json"
  ],
  "workspaces": [
    "web"
  ]
}
